{
  "schema": "totem.extension/v0",
  "id": "clock",
  "name": "Totem Clock",
  "version": "0.2.0",
  "compatibility": {
    "totem": ">=0.2.0 <0.3.0",
    "sdk": ">=0.2.0 <0.3.0"
  },
  "enabledByDefault": true,
  "entrypoints": { "backend": "./backend/index.js" },
  "lifecycle": { "start": "on-demand" },
  "permissions": ["display.present"],
  "events": {
    "publish": ["extension.clock.tick"]
  },
  "contributions": {
    "display": [{ "id": "clock", "title": "Clock" }],
    "dashboard": [{ "id": "clock", "title": "Clock" }]
  },
  "settings": {
    "timeZone": { "type": "string", "default": "local" },
    "hour12": { "type": "boolean", "default": false }
  }
}
